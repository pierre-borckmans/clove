{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and menu-bar popover",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "dialog:allow-open",
    "positioner:default"
  ]
}
