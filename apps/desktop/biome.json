{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!src-tauri", "!dist", "!src/components/ui", "!screenshots", "!assets/*.svg"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "noLabelWithoutControl": "off" },
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "nursery": {}
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
